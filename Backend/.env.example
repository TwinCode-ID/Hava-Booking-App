PUBLIC_API_ORIGIN=http://localhost:5000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Hava
WEBAUTHN_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
APPLE_CLIENT_ID=
APPLE_CLIENT_ID_WEB=
